# =========================== AMR: шаблон .env ===========================
# Скопируйте этот файл в .env (в КОРЕНЬ репозитория) и заполните значения.
# Файл .env добавлен в .gitignore — не коммитьте его!
# Подробное описание получения каждого токена — в SETUP.md, раздел 2.

# ---------- Telegram ----------
# Токен бота от @BotFather
tg_token=

# ID канала (бот — админ с правом публикации в темы), формат -100xxxxxxxxxx
tg_channel_id=

# ID служебного чата/темы для логов скриптов
tg_logger_id=

# ---------- Стриминги ----------
# Токен Яндекс.Музыки (new_releases.py, zvym_links.py)
ym_token=

# Токен Звука (zvym_links.py; без него — анонимный режим)
zv_token=

# ---------- Только для server.py ----------
# Пароль входа в режим редактирования на http://localhost:8000
admin_token=
